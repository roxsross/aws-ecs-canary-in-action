{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "output": "cdk.out",
  "watch": {
    "include": ["bin/**/*.ts", "lib/**/*.ts"],
    "exclude": ["README.md", "cdk*.json", "node_modules", "cdk.out"]
  },
  "context": {
    "//": "Fill vpcId and publicSubnetIds here, or pass them with -c on the command line.",
    "projectName": "canary-lab",
    "vpcId": "",
    "publicSubnetIds": "",
    "serviceSubnetIds": "",
    "assignPublicIp": "true",
    "allowedIngressCidr": "0.0.0.0/0",

    "imageTag": "v1",
    "containerImage": "",
    "ecrRepositoryName": "",
    "createEcrRepository": "false",
    "containerPort": "8080",
    "cpuArchitecture": "X86_64",

    "taskCpu": "256",
    "taskMemory": "512",
    "stableDesiredCount": "2",
    "canaryDesiredCount": "0",
    "stableAppVersion": "1.0.0",
    "canaryAppVersion": "2.0.0",
    "enableExecuteCommand": "true",

    "stableWeight": "100",
    "canaryWeight": "0",

    "alarmPeriod": "60",
    "alarmEvaluationPeriods": "1",
    "alarm5xxThreshold": "3",
    "alarmLatencyThresholdSeconds": "1",
    "alarmErrorRateThreshold": "5",
    "enableEmfAlarm": "true",
    "enableDashboard": "true",
    "alarmSnsTopicArn": "",

    "metricsNamespace": "CanaryLab",
    "recordMode": "full",
    "adminToken": "",
    "grantListenerRead": "true",
    "logRetentionDays": "7",

    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-ecs:disableEcsImdsBlocking": false,
    "@aws-cdk/aws-ecs:reduceEc2FargateCloudWatchPermissions": true,
    "@aws-cdk/aws-cloudwatch-actions:changeLambdaPermissionLogicalIdForLambdaAction": true
  }
}
